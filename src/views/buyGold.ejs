<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buy Gold</title>
    <link rel="stylesheet" href="css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="js/script.js" defer></script>
</head>

<body>
    <div class="container">
        <div class="card p-4">
            <ul class="nav nav-tabs mb-3" id="goldTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="buy-tab" data-bs-toggle="tab" data-bs-target="#buy"
                        type="button" role="tab">Mua Vàng</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="sell-tab" data-bs-toggle="tab" data-bs-target="#sell" type="button"
                        role="tab">Bán Vàng</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="portfolio-tab" data-bs-toggle="tab" data-bs-target="#portfolio"
                        type="button" role="tab">Tài sản tích trữ</button>
                </li>
            </ul>
            <div class="tab-content" id="goldTabContent">
                <!-- Tab Mua Vàng -->
                <div class="tab-pane fade show active" id="buy" role="tabpanel">
                    <h4 class="mb-3">Nhập thông tin Mua Vàng</h4>
                    <form action="/addbuygold" method="post">
                        <div class="mb-3">
                            <label for="buyDate" class="form-label">Ngày mua</label>
                            <input type="datetime-local" class="form-control" id="dateBuy" name="date">
                        </div>
                        <div class="mb-3">
                            <label for="buyType" class="form-label">Loại tài sản</label>
                            <select class="form-select" id="typeGoldBuy" name="typeGold">
                                <% for(let i=0; i < data.length; i++){ %>
                                    <option value="<%= data[i].id %>">
                                        <%=data[i].tentaisan%>
                                    </option>
                                    <%}%>

                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="buyQuantity" class="form-label">Số lượng (chỉ):</label>
                            <input type="number" class="form-control" id="buyQuantity" name="buyQuantity"
                                placeholder="Nhập số lượng" min="1">
                        </div>
                        <div class="mb-3">
                            <label for="buyPrice" class="form-label">Giá mua:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="buyPrice" placeholder="Giá hiện tại"
                                    name="buyPrice">
                                <button type="button" class="btn btn-outline-secondary">Cập
                                    nhật</button>
                                <!-- 💡 -->
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Mô tả:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="buydescription" name="buydescription"
                                    placeholder="Nhập mô tả">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Mua ngay</button>
                    </form>

                </div>

                <!-- Tab Bán Vàng -->
                <div class="tab-pane fade" id="sell" role="tabpanel">
                    <h4 class="mb-3">Nhập thông tin Bán Vàng</h4>
                    <form>
                        <div class="mb-3">
                            <label for="sellDate" class="form-label">Ngày bán</label>
                            <input type="date" class="form-control" id="dateSell" name="date">
                        </div>
                        <div class="mb-3">
                            <label for="sellType" class="form-label">Loại vàng</label>
                            <select class="form-select" id="typeGoldSell">
                                <option value="9999">9999</option>
                                <option value="980">980</option>
                                <option value="680">680</option>
                                <option value="610">610</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="sellQuantity" class="form-label">Số lượng (chỉ):</label>
                            <input type="number" class="form-control" id="sellQuantity" placeholder="Nhập số lượng"
                                min="1">
                        </div>
                        <div class="mb-3">
                            <label for="sellPrice" class="form-label">Giá bán:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="sellPrice" placeholder="Giá hiện tại">
                                <button type="button" class="btn btn-outline-secondary" onclick="getGoldPrice()">Cập
                                    nhật</button>
                                <!-- 💡 -->
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Mô tả:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="selldescription" placeholder="Nhập mô tả">
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary" onclick="banvang()">Bán ngay</button>
                    </form>
                </div>
                <!-- Tab Tài sản tích trữ -->
                <div class="tab-pane fade" id="portfolio" role="tabpanel">
                    <h4 class="mb-3">Tài sản vàng tích trữ</h4>

                    <table class="table table-bordered align-middle" id="goldTable">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày mua</th>
                                <th>Loại vàng</th>
                                <th>Số lượng (chỉ)</th>
                                <th>Giá mua (VND/chỉ)</th>
                                <th>Giá hiện tại</th>
                                <th>Lợi nhuận</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dòng mặc định -->
                            <tr>
                                <td><input type="date" class="form-control" value="2024-01-01"></td>
                                <td>
                                    <select class="form-select">
                                        <option value="SJC">SJC</option>
                                        <option value="BTMC 9999">BTMC 9999</option>
                                    </select>
                                </td>
                                <td><input type="number" class="form-control" value="5" min="0" step="0.1"></td>
                                <td><input type="number" class="form-control" value="7000000"></td>
                                <td><input type="text" class="form-control" readonly></td>
                                <td><input type="text" class="form-control" readonly></td>
                                <td><button class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mb-3">
                        <button class="btn btn-outline-primary" onclick="addRow()">➕ Thêm đợt mua</button>
                        <button class="btn btn-success ms-2" onclick="calculateAllProfits()">📊 Tính lợi
                            nhuận</button>
                    </div>

                    <div class="alert alert-info mt-3" id="totalProfit" style="display:none;"></div>
                </div>

            </div>
        </div>
    </div>
</body>

</html>